# Rust
/target/
**/*.rs.bk
Cargo.lock.bak

# Bevy / dynamic linking artifacts
*.pdb

# IDE / editor
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
.DS_Store

