{
    "name": "Delta-V beyond Sector 3.26 (xhost-optimized)",
    "build": {
        "dockerfile": "Dockerfile"
    },
    // Mount the host's X11 socket so Bevy can open a window on the host
    // display. Requires a Linux host running X11 (or XWayland).
    // BEFORE OPENING/RESTARTING THE CONTAINER:
    //   1. Run once per session on the host:  xhost +local:
    //   2. If you switched users/sessions and DISPLAY changed (e.g., :0 to :1),
    //      just restart the container or reload the window so VS Code fetches the new env.
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
        // Use mold as the default linker for faster iteration.
        "RUSTFLAGS": "-C link-arg=-fuse-ld=mold"
        // XDG_RUNTIME_DIR remains deliberately unset.
    },
    "mounts": [
        // We only need the X11 sockets. No .Xauthority mount needed when using 'xhost +local:'
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached"
    ],
    "runArgs": [
        // GPU passthrough (DRI render node).
        "--device=/dev/dri",
        // Group memberships needed to open the DRI devices.
        "--group-add=video",
        "--group-add=109",
        // Networking for cargo / crates.io.
        "--network=host"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "tamasfe.even-better-toml",
                "vadimcn.vscode-lldb",
                "serayuzgur.crates",
                "usernamehw.errorlens"
            ],
            "settings": {
                "rust-analyzer.check.command": "clippy",
                "editor.formatOnSave": true,
                "[rust]": {
                    "editor.defaultFormatter": "rust-lang.rust-analyzer"
                },
                "files.eol": "\n"
            }
        }
    },
    "remoteUser": "vscode",
    "postCreateCommand": "rustc --version && cargo --version && (vulkaninfo --summary || true)"
}