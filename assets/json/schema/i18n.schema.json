{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://delta-v-beyond-sector-3-26/schema/i18n",
    "title": "Internationalization",
    "description": "AGENTS: before modifying this schema, read AGENTS.md.\n\nTranslation files with a fixed nested structure that mirrors a typed Rust hierarchy. Keys are validated at compile time; missing or mistyped keys are compiler errors.\n\nSee ADR-0037.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "ui",
        "number_format",
        "speed",
        "entity_types"
    ],
    "properties": {
        "number_format": {
            "description": "Number formatting configuration.",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "decimal_separator",
                "thousands_separator"
            ],
            "properties": {
                "decimal_separator": {
                    "description": "Decimal separator character (e.g. '.' for English, ',' for German).",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1
                },
                "thousands_separator": {
                    "description": "Thousands separator character (e.g. ',' for English, '.' for German).",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1
                }
            }
        },
        "speed": {
            "description": "Speed display unit strings.",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "unit_ms",
                "unit_kmh",
                "unit_kms",
                "unit_pch",
                "unit_c"
            ],
            "properties": {
                "unit_ms": {
                    "description": "Unit abbreviation for meters per second.",
                    "type": "string"
                },
                "unit_kmh": {
                    "description": "Unit abbreviation for kilometers per hour.",
                    "type": "string"
                },
                "unit_kms": {
                    "description": "Unit abbreviation for kilometers per second.",
                    "type": "string"
                },
                "unit_pch": {
                    "description": "Unit abbreviation for parsecs per hour.",
                    "type": "string"
                },
                "unit_c": {
                    "description": "Unit abbreviation for fraction of light speed.",
                    "type": "string"
                }
            }
        },
        "entity_types": {
            "description": "Entity type translations (e.g., ship, asteroid, station).",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "ship",
                "asteroid",
                "station"
            ],
            "properties": {
                "ship": {
                    "description": "Ship entity type translation.",
                    "type": "string"
                },
                "asteroid": {
                    "description": "Asteroid entity type translation.",
                    "type": "string"
                },
                "station": {
                    "description": "Station entity type translation.",
                    "type": "string"
                }
            }
        },
        "ui": {
            "description": "UI translations.",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "menu",
                "notification"
            ],
            "properties": {
                "menu": {
                    "description": "Menu translations.",
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "keybindings",
                        "navigation"
                    ],
                    "properties": {
                        "keybindings": {
                            "description": "Keybindings menu translations.",
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "title",
                                "close",
                                "group",
                                "action",
                                "key"
                            ],
                            "properties": {
                                "title": {
                                    "description": "Menu title.",
                                    "type": "string"
                                },
                                "close": {
                                    "description": "Close button hint.",
                                    "type": "string"
                                },
                                "group": {
                                    "description": "Action group names.",
                                    "type": "object",
                                    "additionalProperties": {
                                        "type": "string"
                                    }
                                },
                                "action": {
                                    "description": "Logical action names.",
                                    "type": "object",
                                    "additionalProperties": {
                                        "type": "string"
                                    }
                                },
                                "key": {
                                    "description": "Physical key names.",
                                    "type": "object",
                                    "additionalProperties": {
                                        "type": "string"
                                    }
                                }
                            }
                        },
                        "navigation": {
                            "description": "Navigation menu translations.",
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "title",
                                "close",
                                "empty_list"
                            ],
                            "properties": {
                                "title": {
                                    "description": "Menu title.",
                                    "type": "string"
                                },
                                "close": {
                                    "description": "Close button hint.",
                                    "type": "string"
                                },
                                "empty_list": {
                                    "description": "Empty list placeholder text.",
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "notification": {
                    "description": "Notification translations.",
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "camera",
                        "targeting_mode",
                        "targeting_mode_name",
                        "camera_name",
                        "target_selected",
                        "nav_object_selected",
                        "no_targets",
                        "no_nav_objects"
                    ],
                    "properties": {
                        "camera": {
                            "description": "Camera notification template. Use `{camera_name}` as placeholder.",
                            "type": "string"
                        },
                        "targeting_mode": {
                            "description": "Targeting mode notification template. Use `{mode}` as placeholder.",
                            "type": "string"
                        },
                        "targeting_mode_name": {
                            "description": "Targeting mode name translations.",
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "combat",
                                "nav"
                            ],
                            "properties": {
                                "combat": {
                                    "description": "Combat targeting mode name.",
                                    "type": "string"
                                },
                                "nav": {
                                    "description": "Navigation targeting mode name.",
                                    "type": "string"
                                }
                            }
                        },
                        "camera_name": {
                            "description": "Camera name translations.",
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        },
                        "target_selected": {
                            "description": "Target selected notification template. Use `{entity_id}` and `{entity_type}` as placeholders.",
                            "type": "string"
                        },
                        "nav_object_selected": {
                            "description": "Nav object selected notification template. Use `{entity_id}` and `{entity_type}` as placeholders.",
                            "type": "string"
                        },
                        "no_targets": {
                            "description": "No targets available notification.",
                            "type": "string"
                        },
                        "no_nav_objects": {
                            "description": "No navigation objects available notification.",
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}
